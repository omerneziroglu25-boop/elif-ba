          "desc": "Elif üstün + Be cezimli"
        },
        {
          "ar": "قُلْ",
          "tr": "Kul",
          "desc": "Kaf ötre + Lam cezimli"
        },
        {
          "ar": "مِنْ",
          "tr": "Min",
          "desc": "Mim esre + Nun cezimli"
        },
        {
