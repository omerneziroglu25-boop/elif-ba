  "advanced": [
    {
      "title": "Cezm (Sükûn) - ْ",
      "badge": "Harfi Tutturma / Durdurma",
      "rule": "Cezm, harfin üzerine konulan küçük daire şeklindedir. Harfi sessiz kılar ve önceki harfe bağlar.",
      "examples": [
        {
          "ar": "اَبْ",
